# Add your NVIDIA API key (or OpenAI API key) to run the workflows.
NVIDIA_API_KEY=
OPENAI_API_KEY=

# Local defaults. Leave these settings unchanged for your first run.
MASTRA_STORAGE_URL=file:./incident.db
MASTRA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
RUNTIME_MODE=local
PORT=3001

# Dashboard Authentication & Origin.
DASHBOARD_AUTH_ENABLED=false
DASHBOARD_ORIGIN=http://localhost:3001
DASHBOARD_CSRF_SECRET=

# Zetaris Network Connection (Federated Query Engine)
ZETARIS_BASE_URL=http://127.0.0.1:3000
ZETARIS_ADMIN_EMAIL=admin@zetaris.com
ZETARIS_ADMIN_PASSWORD=Zetaris1@
ZETARIS_ADMIN_ORG=zetaris

# Provider integration flags (disabled by default for local-first operations).
WEBHOOKS_ENABLED=false
WORKOS_PROVIDER_ENABLED=false
IPINFO_PROVIDER_ENABLED=false
LINEAR_PROVIDER_ENABLED=false
DEVICE_TRUST_PROVIDER_ENABLED=false
LOCAL_APPROVALS_ENABLED=false

# Optional approval resume secret outside local mode (e.g. staging/production).
# APPROVAL_RESUME_SECRET=
